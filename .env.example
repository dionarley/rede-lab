# Copie para .env e ajuste conforme necessário:
#   cp .env.example .env
#
# Container engine: auto | podman | docker
CONTAINER_ENGINE=auto

# ---- Rede simulada (bridge) ----
NETWORK_NAME=lab-net
SUBNET=10.0.0.0/24
GATEWAY=10.0.0.1

# ---- Endereços dos nós (WAN/ISP) ----
ISP_IP=10.0.0.1
CASA_IP=10.0.0.10
SERVIDOR_IP=10.0.0.20

# ---- WireGuard (VPN) ----
WG_SERVIDOR_IP=10.0.99.1
WG_CASA_IP=10.0.99.10
WG_PORT=51820
WG_KEEPALIVE=15

# ---- SSH ----
SSH_USER=labuser
SSH_PASS=labpass
SSH_PORT=22

# ============================================================
# ATENÇÃO: este é um TEMPLATE público.
# NUNCA coloque segredos reais (tokens, senhas, chaves) aqui.
# Copie para .env (ignorado pelo git) e ajuste localmente:
#   cp .env.example .env
# ============================================================
#
# Container engine: auto | podman | docker
CONTAINER_ENGINE=auto

# ---- Rede simulada (bridge) ----
NETWORK_NAME=lab-net
SUBNET=10.0.0.0/24
# IP reservado da bridge (não é container). O gateway lógico é o ISP 10.0.0.1.
GATEWAY=10.0.0.254

# ---- Compose ----
COMPOSE_PROJECT_NAME=rede-lab
# Forçar o binário do Compose (opcional):
# COMPOSE_BIN=podman-compose
# COMPOSE_BIN=docker compose

# ---- Endereços dos nós (WAN/ISP) ----
ISP_IP=10.0.0.1
CASA_IP=10.0.0.10
SERVIDOR_IP=10.0.0.20

# ---- WireGuard (VPN) ----
WG_SERVIDOR_IP=10.0.99.1
WG_CASA_IP=10.0.99.10
WG_PORT=51820
WG_KEEPALIVE=15

# ---- SSH ----
# Senha apenas de laboratório; não reutilize em produção.
SSH_USER=labuser
SSH_PASS=labpass
SSH_PORT=22
